{
  "name": "flashi",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source, mobile-first flashcard web app modeled on AnkiDroid. Imports Anki .apkg decks.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:artifact && npm run build:pwa",
    "build:artifact": "vite build --mode artifact",
    "build:pwa": "vite build --mode pwa",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test",
    "preview": "vite preview --outDir dist-pwa",
    "build:golden": "vite build --mode golden",
    "golden": "npm run build:golden && tsx scripts/golden.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "mathjax": "^3.2.2",
    "preact": "^11.1.0"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "ssim.js": "^3.5.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
